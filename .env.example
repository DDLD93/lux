# --- Server ---
LUX_ADDR=:8080
LUX_SERVER_URL=http://localhost:8080
LUX_SCRATCH_DIR=/tmp/lux
LUX_WORKERS=4

# --- Postgres ---
DATABASE_URL=postgres://lux:lux@localhost:5432/lux?sslmode=disable

# --- MinIO / S3 (AWS SDK Go v2) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lux
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_PRESIGN_TTL=5m
